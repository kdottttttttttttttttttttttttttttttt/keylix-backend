{
  "name": "keylix-launcher",
  "version": "1.0.0",
  "description": "Project Keylix Launcher - Retrac style (C2S2)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "axios": "^1.6.0",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.keylix.launcher",
    "productName": "Keylix Launcher",
    "win": { "target": "nsis", "icon": "renderer/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
